# Cloudflare Pages / Workers static assets — security headers (HTTP Observatory)
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Resource-Policy: same-site
  # same-origin breaks GIS popup postMessage (callback never fires).
  # https://developers.google.com/identity/gsi/web/guides/get-google-api-clientid#cross_origin_opener_policy
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: credentialless
  Permissions-Policy: accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'sha256-0UjF+kkviRBlwd1Y1yWErzgC1DWDjuEx04O1TJLeBaI=' https://accounts.google.com https://apis.google.com https://www.clarity.ms https://scripts.clarity.ms https://connect.facebook.net; script-src-elem 'self' 'sha256-0UjF+kkviRBlwd1Y1yWErzgC1DWDjuEx04O1TJLeBaI=' https://accounts.google.com https://apis.google.com https://www.clarity.ms https://scripts.clarity.ms https://connect.facebook.net; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com https://*.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudinary.com https://*.googleusercontent.com https://*.gstatic.com https://*.fbcdn.net https://*.facebook.com https://*.cdninstagram.com https://wsrv.nl https://api.dicebear.com https://ui-avatars.com https://i.ytimg.com https://via.placeholder.com https://c.clarity.ms; connect-src 'self' https://winzor.onrender.com https://accounts.google.com https://apis.google.com https://*.googleusercontent.com https://res.cloudinary.com https://*.cloudinary.com https://www.clarity.ms https://*.clarity.ms https://c.clarity.ms https://connect.facebook.net https://graph.facebook.com https://www.facebook.com; frame-src https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://web.facebook.com; worker-src 'self' blob:; manifest-src 'self'

